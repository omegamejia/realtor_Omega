# Copy to .env.local and fill in per student.
# The GHL token is captured at intake and stored here — NEVER in site.config.ts.

# GoHighLevel Private Integration Token (needs contacts write scope, at minimum).
GHL_API_TOKEN=

# Note: the GHL location ID lives in site.config.ts under ghl.locationId.

# Anthropic API key for the on-site chat widget (/api/chat). Leave blank and the
# widget runs in seed mode (points visitors to phone/contact). This is a paid API
# per message on a public page — see README for cost + rate-limit notes.
ANTHROPIC_API_KEY=
