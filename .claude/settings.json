{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run gate)",
      "Bash(npm run launch:check)",
      "Bash(npm run validate:schema)",
      "Bash(npm run report)",
      "Bash(npm run update:engine)",
      "Bash(ls:*)",
      "Bash(find ~ -maxdepth 5 -type d -name \"11-Brand-System\")",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
